<?php

namespace {{ namespace }};

use {{ interface_namespace }}\{{ class }}RepositoryInterface;
use LaravelArchitect\Base\BaseMySQLRepository;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Collection;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Pagination\LengthAwarePaginator;

class MySQL{{ class }}Repository extends BaseMySQLRepository implements {{ class }}RepositoryInterface
{
    protected string $table = '{{ table }}';
    protected string $modelClass = '{{ model_namespace }}\{{ class }}';

    public function all(): Collection
    {
        $results = DB::select("SELECT * FROM {$this->table} WHERE deleted_at IS NULL ORDER BY id DESC");
        return collect($results)->map(fn($item) => $this->hydrateModel($item));
    }

    public function paginate(?int $perPage = null): LengthAwarePaginator
    {
        $limit = $perPage ?? config('api_scaffolding.response_settings.pagination_limit', 15);
        $page = LengthAwarePaginator::resolveCurrentPage();
        $offset = ($page - 1) * $limit;

        $results = DB::select(
            "SELECT * FROM {$this->table} WHERE deleted_at IS NULL ORDER BY id DESC LIMIT ? OFFSET ?",
            [$limit, $offset]
        );

        $totalResult = DB::selectOne("SELECT COUNT(*) as count FROM {$this->table} WHERE deleted_at IS NULL");
        $total = $totalResult->count ?? 0;

        $items = collect($results)->map(fn($item) => $this->hydrateModel($item));

        return new LengthAwarePaginator($items, $total, $limit, $page, [
            'path' => LengthAwarePaginator::resolveCurrentPath()
        ]);
    }

    public function find(int $id): ?Model
    {
        $result = DB::selectOne(
            "SELECT * FROM {$this->table} WHERE id = ? AND deleted_at IS NULL LIMIT 1",
            [$id]
        );

        return $result ? $this->hydrateModel($result) : null;
    }

    public function create(array $data): Model
    {
        $columns = array_keys($data);
        $placeholders = array_fill(0, count($data), '?');

        DB::beginTransaction();

        try {
            $sql = sprintf(
                "INSERT INTO {$this->table} (%s, created_at, updated_at) VALUES (%s, NOW(), NOW())",
                implode(', ', $columns),
                implode(', ', $placeholders)
            );

            DB::insert($sql, array_values($data));

            $id = DB::connection()->getPdo()->lastInsertId();
            $record = $this->find((int) $id);

            DB::commit();

            if (!$record) {
                throw new \RuntimeException("Failed to retrieve created record with ID: {$id}");
            }

            return $record;

        } catch (\Exception $e) {
            DB::rollBack();
            throw $e;
        }
    }

    public function update(int $id, array $data): bool
    {
        if (empty($data)) {
            return false;
        }

        $setParts = array_map(fn($col) => "{$col} = ?", array_keys($data));
        $values = array_values($data);
        $values[] = $id;

        $sql = sprintf(
            "UPDATE {$this->table} SET %s, updated_at = NOW() WHERE id = ? AND deleted_at IS NULL",
            implode(', ', $setParts)
        );

        return DB::update($sql, $values) > 0;
    }

    public function delete(int $id): bool
    {
        if ($this->hasSoftDeletes()) {
            $sql = "UPDATE {$this->table} SET deleted_at = NOW() WHERE id = ? AND deleted_at IS NULL";
            return DB::update($sql, [$id]) > 0;
        }

        $sql = "DELETE FROM {$this->table} WHERE id = ?";
        return DB::delete($sql, [$id]) > 0;
    }

    public function search(array $filters, ?int $perPage = null): LengthAwarePaginator
    {
        $whereClauses = ['deleted_at IS NULL'];
        $bindings = [];

        foreach ($filters as $field => $value) {
            if ($value !== null && $value !== '') {
                $whereClauses[] = "{$field} LIKE ?";
                $bindings[] = "%{$value}%";
            }
        }

        $whereString = implode(' AND ', $whereClauses);

        $limit = $perPage ?? config('api_scaffolding.response_settings.pagination_limit', 15);
        $page = LengthAwarePaginator::resolveCurrentPage();
        $offset = ($page - 1) * $limit;

        $results = DB::select(
            "SELECT * FROM {$this->table} WHERE {$whereString} ORDER BY id DESC LIMIT ? OFFSET ?",
            array_merge($bindings, [$limit, $offset])
        );

        $totalResult = DB::selectOne(
            "SELECT COUNT(*) as count FROM {$this->table} WHERE {$whereString}",
            $bindings
        );
        $total = $totalResult->count ?? 0;

        $items = collect($results)->map(fn($item) => $this->hydrateModel($item));

        return new LengthAwarePaginator($items, $total, $limit, $page, [
            'path' => LengthAwarePaginator::resolveCurrentPath()
        ]);
    }

    public function restore(int $id): bool
    {
        if (!$this->hasSoftDeletes()) {
            return false;
        }

        $sql = "UPDATE {$this->table} SET deleted_at = NULL, updated_at = NOW() WHERE id = ?";
        return DB::update($sql, [$id]) > 0;
    }

    public function forceDelete(int $id): bool
    {
        $sql = "DELETE FROM {$this->table} WHERE id = ?";
        return DB::delete($sql, [$id]) > 0;
    }

    public function findMany(array $ids): Collection
    {
        if (empty($ids)) {
            return collect();
        }

        $placeholders = implode(',', array_fill(0, count($ids), '?'));
        $sql = "SELECT * FROM {$this->table} WHERE id IN ({$placeholders}) AND deleted_at IS NULL";

        $results = DB::select($sql, $ids);

        return collect($results)->map(fn($item) => $this->hydrateModel($item));
    }

    public function createMany(array $records): Collection
    {
        if (empty($records)) {
            return collect();
        }

        DB::beginTransaction();

        try {
            $created = collect();

            foreach ($records as $data) {
                $columns = array_keys($data);
                $placeholders = array_fill(0, count($data), '?');

                $sql = sprintf(
                    "INSERT INTO {$this->table} (%s, created_at, updated_at) VALUES (%s, NOW(), NOW())",
                    implode(', ', $columns),
                    implode(', ', $placeholders)
                );

                DB::insert($sql, array_values($data));
                $id = DB::connection()->getPdo()->lastInsertId();

                $record = $this->find((int) $id);
                if ($record) {
                    $created->push($record);
                }
            }

            DB::commit();

            return $created;

        } catch (\Exception $e) {
            DB::rollBack();
            throw $e;
        }
    }

    public function updateMany(array $records): int
    {
        if (empty($records)) {
            return 0;
        }

        DB::beginTransaction();

        try {
            $updated = 0;

            foreach ($records as $data) {
                if (!isset($data['id'])) {
                    continue;
                }

                $id = $data['id'];
                unset($data['id']);

                if (empty($data)) {
                    continue;
                }

                $setParts = array_map(fn($col) => "{$col} = ?", array_keys($data));
                $values = array_values($data);
                $values[] = $id;

                $sql = sprintf(
                    "UPDATE {$this->table} SET %s, updated_at = NOW() WHERE id = ? AND deleted_at IS NULL",
                    implode(', ', $setParts)
                );

                if (DB::update($sql, $values) > 0) {
                    $updated++;
                }
            }

            DB::commit();

            return $updated;

        } catch (\Exception $e) {
            DB::rollBack();
            throw $e;
        }
    }

    public function deleteMany(array $ids): int
    {
        if (empty($ids)) {
            return 0;
        }

        $placeholders = implode(',', array_fill(0, count($ids), '?'));

        if ($this->hasSoftDeletes()) {
            $sql = "UPDATE {$this->table} SET deleted_at = NOW() WHERE id IN ({$placeholders}) AND deleted_at IS NULL";
            return DB::update($sql, $ids);
        }

        $sql = "DELETE FROM {$this->table} WHERE id IN ({$placeholders})";
        return DB::delete($sql, $ids);
    }

    public function restoreMany(array $ids): int
    {
        if (empty($ids) || !$this->hasSoftDeletes()) {
            return 0;
        }

        $placeholders = implode(',', array_fill(0, count($ids), '?'));
        $sql = "UPDATE {$this->table} SET deleted_at = NULL, updated_at = NOW() WHERE id IN ({$placeholders})";

        return DB::update($sql, $ids);
    }

    public function forceDeleteMany(array $ids): int
    {
        if (empty($ids)) {
            return 0;
        }

        $placeholders = implode(',', array_fill(0, count($ids), '?'));
        $sql = "DELETE FROM {$this->table} WHERE id IN ({$placeholders})";

        return DB::delete($sql, $ids);
    }

    protected function hasSoftDeletes(): bool
    {
        static $cache = null;

        if ($cache === null) {
            $columns = DB::select("SHOW COLUMNS FROM {$this->table}");
            $cache = collect($columns)->contains(fn($col) => $col->Field === 'deleted_at');
        }

        return $cache;
    }

    protected function hydrateModel(object $data): Model
    {
        $model = new $this->modelClass;

        foreach (get_object_vars($data) as $key => $value) {
            $model->setAttribute($key, $value);
        }

        $model->exists = true;
        $model->syncOriginal();

        return $model;
    }
}
