<?php

use {{ model_namespace }}\{{ class }};
use Illuminate\Foundation\Testing\RefreshDatabase;

uses(RefreshDatabase::class);

beforeEach(function () {
    $this->artisan('migrate');
});

afterEach(function () {
    $this->artisan('migrate:rollback');
});

describe('{{ class }} Listing', function () {
    test('can list {{ route }}', function () {
        {{ class }}::factory()->count(3)->create();

        $response = $this->getJson('/api/{{ route }}');

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200))
            ->assertJsonStructure([
                'data' => [
                    '*' => ['id']
                ],
                'meta' => [
                    'total',
                    'count',
                    'per_page',
                    'current_page',
                    'total_pages'
                ],
                'links' => [
                    'first',
                    'last',
                    'prev',
                    'next'
                ]
            ]);
    });

    test('returns paginated {{ route }}', function () {
        {{ class }}::factory()->count(25)->create();

        $response = $this->getJson('/api/{{ route }}?per_page=10');

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200))
            ->assertJsonPath('meta.per_page', 10)
            ->assertJsonPath('meta.total', 25);

        expect($response->json('data'))->toHaveCount(10);
    });

    test('can search {{ route }}', function () {
        {{ class }}::factory()->create([{{ search_field }} => 'Searchable']);
        {{ class }}::factory()->create([{{ search_field }} => 'Different']);

        $response = $this->getJson('/api/{{ route }}?search=Searchable');

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200));
        expect($response->json('meta.total'))->toBe(1);
    });
});

