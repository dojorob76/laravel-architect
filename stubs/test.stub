describe('{{ class }} Batch Operations', function () {
    test('can batch show {{ route }}', function () {
        $records = {{ class }}::factory()->count(5)->create();
        $ids = $records->pluck('id')->toArray();

        $response = $this->postJson('/api/{{ route }}/batch/show', [
            'ids' => array_slice($ids, 0, 3)
        ]);

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200))
            ->assertJsonStructure(['data', 'count'])
            ->assertJsonPath('count', 3);
    });

    test('can batch create {{ route }}', function () {
        $records = [
{{ test_batch_create }}
        ];

        $response = $this->postJson('/api/{{ route }}/batch', [
            'records' => $records
        ]);

        $response->assertStatus(config('api_scaffolding.status_codes.created', 201))
            ->assertJsonStructure(['data', 'count', 'message'])
            ->assertJsonPath('count', count($records));

        foreach ($records as $record) {
            $this->assertDatabaseHas('{{ table }}', $record);
        }
    });

    test('validates each record in batch create', function () {
        $records = [
            [{{ search_field }} => 'Valid'],
            [],
        ];

        $response = $this->postJson('/api/{{ route }}/batch', [
            'records' => $records
        ]);

        $response->assertStatus(config('api_scaffolding.status_codes.unprocessable_entity', 422));
    });

    test('can batch update {{ route }}', function () {
        $records = {{ class }}::factory()->count(3)->create();

        $updates = $records->map(function ($record) {
