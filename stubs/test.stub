describe('{{ class }} Retrieval', function () {
    test('can show single {{ singular_route }}', function () {
        $record = {{ class }}::factory()->create();

        $response = $this->getJson("/api/{{ route }}/{$record->id}");

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200))
            ->assertJsonStructure(['data' => ['id']])
            ->assertJson([
                'data' => [
                    'id' => $record->id
                ]
            ]);
    });

    test('returns 404 when {{ singular_route }} not found', function () {
        $response = $this->getJson('/api/{{ route }}/99999');

        $response->assertStatus(config('api_scaffolding.status_codes.not_found', 404))
            ->assertJson([
                'message' => config('api_scaffolding.messages.not_found', 'Resource not found.')
            ]);
    });
});

describe('{{ class }} Update', function () {
    test('can update {{ singular_route }}', function () {
        $record = {{ class }}::factory()->create();

        $updateData = [
{{ test_update_data }}
        ];

        $response = $this->patchJson("/api/{{ route }}/{$record->id}", $updateData);

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200))
            ->assertJsonStructure(['data' => ['id']]);

        $this->assertDatabaseHas('{{ table }}', array_merge(['id' => $record->id], $updateData));
    });

    test('can partially update {{ singular_route }}', function () {
        $record = {{ class }}::factory()->create();

        $partialData = [
{{ test_partial_update }}
        ];

        $response = $this->patchJson("/api/{{ route }}/{$record->id}", $partialData);

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200));

        $this->assertDatabaseHas('{{ table }}', array_merge(['id' => $record->id], $partialData));
    });

    test('returns 404 when updating non-existent {{ singular_route }}', function () {
        $response = $this->patchJson('/api/{{ route }}/99999', [{{ search_field }} => 'test']);

        $response->assertStatus(config('api_scaffolding.status_codes.not_found', 404));
    });
});

