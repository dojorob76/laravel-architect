describe('{{ class }} Edge Cases', function () {
    test('handles large dataset pagination', function () {
        {{ class }}::factory()->count(100)->create();

        $response = $this->getJson('/api/{{ route }}?per_page=50&page=2');

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200))
            ->assertJsonPath('meta.current_page', 2)
            ->assertJsonPath('meta.total', 100);

        expect($response->json('data'))->toHaveCount(50);
    });

    test('handles empty result set gracefully', function () {
        $response = $this->getJson('/api/{{ route }}');

        $response->assertStatus(config('api_scaffolding.status_codes.success', 200))
            ->assertJsonPath('meta.total', 0);

        expect($response->json('data'))->toBeArray()->toBeEmpty();
    });
});
