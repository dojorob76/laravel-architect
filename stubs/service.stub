<?php

namespace {{ namespace }};

use {{ contracts_namespace }}\{{ class }}RepositoryInterface;{{ additional_imports }}
use LaravelArchitect\Base\BaseService;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Support\Collection;

class {{ class }}Service extends BaseService
{
    /**
     * Create a new service instance.
     */
    public function __construct(
        protected {{ class }}RepositoryInterface $repository,{{ additional_constructor_params }}
    ) {}

    /**
     * Get all records.
     */
    public function getAll(): Collection
    {
        return $this->repository->all();
    }

    /**
     * Get paginated records.
     */
    public function getPaginated(?int $perPage = null): LengthAwarePaginator
    {
        return $this->repository->paginate($perPage);
    }

    /**
     * Find a record by ID.
     */
    public function findById(int $id): ?object
    {
        return $this->repository->find($id);
    }

    /**
     * Create a new record.
     */
    public function create(array $data): object
    {
        return $this->repository->create($data);
    }

    /**
     * Update an existing record.
     */
    public function update(int $id, array $data): bool
    {
        return $this->repository->update($id, $data);
    }

    /**
     * Delete a record.
     */
    public function delete(int $id): bool
    {
        return $this->repository->delete($id);
    }

    /**
     * Search records with filters.
     */
    public function search(array $filters, ?int $perPage = null): LengthAwarePaginator
    {
        return $this->repository->search($filters, $perPage);
    }
{{ additional_methods }}}
