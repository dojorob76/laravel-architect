<?php

namespace {{ namespace }};

use {{ interface_namespace }}\{{ class }}RepositoryInterface;
use LaravelArchitect\Base\BaseService;
use Illuminate\Pagination\LengthAwarePaginator;
use Illuminate\Support\Collection;

class {{ class }}Service extends BaseService
{
    /**
     * Create a new service instance.
     */
    public function __construct(
        protected {{ class }}RepositoryInterface $repository
    ) {}

    /**
     * Get all records.
     */
    public function getAll(): Collection
    {
        return $this->repository->all();
    }

    /**
     * Get paginated records.
     */
    public function getPaginated(?int $perPage = null): LengthAwarePaginator
    {
        return $this->repository->paginate($perPage);
    }

    /**
     * Find a record by ID.
     */
    public function findById(int $id): ?object
    {
        return $this->repository->find($id);
    }

    /**
     * Create a new record.
     */
    public function create(array $data): object
    {
        return $this->repository->create($data);
    }

    /**
     * Update an existing record.
     */
    public function update(int $id, array $data): bool
    {
        return $this->repository->update($id, $data);
    }

    /**
     * Delete a record.
     */
    public function delete(int $id): bool
    {
        return $this->repository->delete($id);
    }

    /**
     * Search records with filters.
     */
    public function search(array $filters, ?int $perPage = null): LengthAwarePaginator
    {
        return $this->repository->search($filters, $perPage);
    }

    /**
     * Restore a soft-deleted record.
     */
    public function restore(int $id): bool
    {
        return $this->repository->restore($id);
    }

    /**
     * Permanently delete a record.
     */
    public function forceDelete(int $id): bool
    {
        return $this->repository->forceDelete($id);
    }

    /**
     * Find multiple records by IDs.
     */
    public function findMany(array $ids): Collection
    {
        return $this->repository->findMany($ids);
    }

    /**
     * Create multiple records.
     */
    public function createMany(array $records): Collection
    {
        return $this->repository->createMany($records);
    }

    /**
     * Update multiple records.
     */
    public function updateMany(array $records): int
    {
        return $this->repository->updateMany($records);
    }

    /**
     * Delete multiple records.
     */
    public function deleteMany(array $ids): int
    {
        return $this->repository->deleteMany($ids);
    }

    /**
     * Restore multiple soft-deleted records.
     */
    public function restoreMany(array $ids): int
    {
        return $this->repository->restoreMany($ids);
    }

    /**
     * Permanently delete multiple records.
     */
    public function forceDeleteMany(array $ids): int
    {
        return $this->repository->forceDeleteMany($ids);
    }
}
