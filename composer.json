{
	"name": "vendor/laravel-architect",
	"description": "Strict API Scaffolding for Laravel using Repository Pattern",
	"type": "library",
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"LaravelArchitect\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"LaravelArchitect\\Tests\\": "tests/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"LaravelArchitect\\LaravelArchitectServiceProvider"
			]
		}
	},
	"require": {
		"php": "^8.4",
		"illuminate/support": "^12.0",
		"illuminate/console": "^12.0",
		"illuminate/database": "^12.0"
	},
	"require-dev": {
		"orchestra/testbench": "^9.0",
		"pestphp/pest": "^3.0",
		"pestphp/pest-plugin-laravel": "^3.0"
	},
	"scripts": {
		"test": "vendor/bin/pest"
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}