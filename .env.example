# Laravel Architect Docker Environment Configuration
#
# This file is OPTIONAL - default values work for most developers.
# Copy to .env and customize if needed.
#
# ⚠️ These are TEST CREDENTIALS for local development only.
# These databases only exist for running package tests.

# MySQL Test Database
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=laravel_architect_test
MYSQL_USER=laravel
MYSQL_PASSWORD=secret

# PostgreSQL Test Database
POSTGRES_DB=laravel_architect_test
POSTGRES_USER=laravel
POSTGRES_PASSWORD=secret
